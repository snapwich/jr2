# Build output and runtime state. Prettier does not read .gitignore, so list them here.
node_modules/
dist/
tmp/
.jr2/
*.tsbuildinfo

# The e2e tier's scratch, and the evidence a FAILED @kind scenario dumps into it before its
# namespace goes (ADR-0010). That evidence is verbatim kubectl and Harness output — a truncated
# yaml, a `<unavailable: …>` placeholder — so prettier parses it, fails, and one failed @kind run
# breaks the format gate until someone deletes the directory. It is a sibling of `tmp/` above, and
# `features/.gitignore` already has it; prettier does not read that file.
features/.tmp/

# pnpm owns this file's format.
pnpm-lock.yaml

# A Go module with its own toolchain (gofmt, `make lint`); config/** is kubebuilder-generated.
# Also outside the pnpm workspace on purpose — see pnpm-workspace.yaml.
operator/

# Generated from operator/config by `just operator-manifest` (kubectl kustomize). Reformatting
# them makes the next render show a spurious diff.
packages/cli/manifests/operator.yaml
