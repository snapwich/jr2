{
  "kind": "http",
  "method": "PUT",
  "url": [
    {
      "text": "https://api.telegram.org/bot"
    },
    {
      "secret": "telegram"
    },
    {
      "text": "/sendMessage"
    }
  ],
  "auth": {
    "basic": {
      "user": [
        {
          "text": "bot"
        }
      ],
      "password": [
        {
          "secret": "telegram-password"
        }
      ]
    }
  },
  "body": {
    "text": "hello, world\n"
  },
  "timeoutMs": 5000,
  "maxBody": 1024
}
