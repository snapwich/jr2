{
  "name": "@jr2/cli",
  "version": "0.1.1",
  "description": "The jr2 CLI: init, up, run — the interface to a jr2 Instance.",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snapwich/jr2.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/snapwich/jr2#readme",
  "bugs": {
    "url": "https://github.com/snapwich/jr2/issues"
  },
  "keywords": [
    "jr2",
    "agents",
    "agentic",
    "xstate",
    "kubernetes",
    "workflow"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "jr2": "bin/jr2.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@jr2/orchestrator": "workspace:*",
    "ts-blank-space": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "xstate": "^5.18.0",
    "zod": "^4.4.3"
  },
  "files": [
    "bin",
    "src",
    "manifests"
