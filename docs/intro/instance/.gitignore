# Runtime state the orchestrator writes under the instance root (ADR-0009): the sqlite snapshot store
# and the dev server's live address. Never checked in.
.jr2/
node_modules/

# Deployment-varying values + creds this instance's jr2.config.ts reads from the environment; the
# `jr2` CLI loads this file automatically (ADR-0019). Never checked in.
.env

# The llama endpoint's TLS material (`npm run certs`): a CA and a leaf for this machine's address. Per
# machine, like `.env`. Never checked in.
certs/
