# node / ts
node_modules/
dist/
tmp/
*.tsbuildinfo
repos/

# instance runtime state: the sqlite store, the dev address, and the token signing key (ADR-0013).
# Never checked in — .jr2/secret is a credential, and dev.json points at a transient local server.
.jr2/

# instance secrets + deployment-varying values (ADR-0019): the CLI loads the `.env` beside an
# instance's jr2.config.ts into the environment its config reads. Never checked in.
.env
.env.*
!.env.example

# the docs bundle (ADR-0072): `pnpm docs:build` assembles it from docs/site, the code, GLOSSARY.md
# and docs/adr. Generated, so never checked in — the one source is the page or the code.
packages/orchestrator/docs/

# the docs site (ADR-0072): `pnpm docs:site` builds the bundle into .vitepress/bundle, copies its
# Reference into reference/ for VitePress to render, and writes the site to .vitepress/dist.
docs/site/reference/
docs/site/.vitepress/bundle/
docs/site/.vitepress/cache/
docs/site/.vitepress/dist/
docs/site/.vitepress/.temp/

# go
operator/bin/
operator/testbin/

# poc — validation artifacts kept on disk but not published; conclusions live in docs/adr/
poc/

# misc
.DS_Store
*.log
